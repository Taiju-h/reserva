APP_ENV=production
APP_URL=https://hanamaru.uzero.style
APP_TIMEZONE=Asia/Tokyo
APP_KEY=replace_with_64_random_hex_characters
ADMIN_PASSWORD_HASH=replace_with_password_hash

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hanamaru
DB_USERNAME=hanamaru
DB_PASSWORD=replace_with_strong_secret

# Stripe Checkout (do not commit actual secrets)
# STRIPE_MODE=disabled | test | live
STRIPE_MODE=disabled
STRIPE_LIVE_ENABLED=no
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Company-funded counseling (Tanseisha)
# Keep disabled until HTTPS warning and privacy notice are approved.
CORPORATE_TLS_APPROVED=no
CORPORATE_PRIVACY_APPROVED=no

# Optional email ownership verification.
# 'off' means email is an identifier, NOT proof of mailbox ownership.
# Set to required after completing Mailgun configuration and delivery test.
CORPORATE_EMAIL_VERIFICATION=off
CORPORATE_MAILGUN_REGION=us
CORPORATE_MAILGUN_DOMAIN=
CORPORATE_MAILGUN_API_KEY=
CORPORATE_MAIL_FROM=
